# Copy to .env at the repo root and fill in. Never commit .env.
# Fill in the three wallet keys with: npm run setup:wallets

# Shop wallet: receives customer payments, holds the USDC float for top-ups
SHOP_PRIVATE_KEY=
# Relayer wallet: submits transferWithAuthorization and pays gas (needs Base Sepolia ETH)
RELAYER_PRIVATE_KEY=
# Customer wallet: only used by the payment spike script
CUSTOMER_PRIVATE_KEY=

# Leave SUPABASE_URL empty to use the in-memory store
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FALLBACK_ZAR_PER_USDC=18.50
# Fees: 250 bps = 2.5% on cash top-ups and cash-outs, at least R1.00 (100 cents). Sends between people are free.
TOPUP_FEE_BPS=250
CASHOUT_FEE_BPS=250
MIN_FEE_ZAR_CENTS=100
ORDER_TTL_SECONDS=60
OWNER_PIN=1234
SHOP_NAME="Mama Thoko's Spaza"
PORT=3000
# URL phones use to reach the server (goes in the till QR). Default: this computer's LAN address.
PUBLIC_URL=
