# Copy to .env at the repo root and fill in. Never commit .env.
# Generate keys with: npm run gen-wallet

# Shop wallet: receives customer payments, holds the USDC float for top-ups
SHOP_PRIVATE_KEY=
# Relayer wallet: submits transferWithAuthorization and pays gas (needs Base Sepolia ETH)
RELAYER_PRIVATE_KEY=

# Leave SUPABASE_URL empty to use the in-memory store
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FALLBACK_ZAR_PER_USDC=18.50
TOPUP_FEE_BPS=200
ORDER_TTL_SECONDS=60
OWNER_PIN=1234
SHOP_NAME="Mama Thoko's Spaza"
PORT=3000
