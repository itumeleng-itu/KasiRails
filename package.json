{
  "name": "kasi-rails",
  "private": true,
  "version": "0.1.0",
  "description": "USDC payments and cash top-ups for spaza shops on Base Sepolia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gen-wallet": "npm run gen-wallet -w @kasi-rails/server",
    "setup:wallets": "tsx apps/server/scripts/setup-wallets.ts",
    "spike": "tsx apps/server/scripts/spike-eip3009.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
